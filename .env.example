# Neon Postgres connection string (pooled). On Vercel this is set automatically by the Neon integration.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Absolute site URL for sitemap / OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to log every tracked event in the browser console.
NEXT_PUBLIC_ANALYTICS_DEBUG=0
